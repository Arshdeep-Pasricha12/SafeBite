<mxfile host="app.diagrams.net">
  <diagram name="State Chart - Restaurant Approval" id="state-diagram">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Restaurant.approval_status  State Machine" style="text;html=1;fontStyle=1;fontSize=16;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="400" height="30" as="geometry"/></mxCell>

        <mxCell id="s_init" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="30" height="30" as="geometry"/></mxCell>

        <mxCell id="s_pending" value="Pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="190" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s_pending_note" value="entry / owner submits&#10;POST /api/restaurants&#10;(default on create)" style="text;html=1;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="240" width="180" height="50" as="geometry"/></mxCell>

        <mxCell id="s_approved" value="Approved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_approved_note" value="entry / visible in public&#10;GET /restaurants listing" style="text;html=1;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="105" width="180" height="40" as="geometry"/></mxCell>

        <mxCell id="s_rejected" value="Rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="340" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_rejected_note" value="entry / hidden from&#10;customers &amp; guests" style="text;html=1;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="385" width="180" height="40" as="geometry"/></mxCell>

        <!-- TRANSITIONS -->
        <mxCell id="t1" style="html=1;endArrow=block;" edge="1" parent="1" source="s_init" target="s_pending"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="t2" value="admin: approve()&#10;PUT /admin/restaurants/&#123;id&#125;/approve" style="html=1;endArrow=block;fontSize=10;exitX=0.75;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="s_pending" target="s_approved">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="t3" value="admin: reject()&#10;PUT /admin/restaurants/&#123;id&#125;/reject" style="html=1;endArrow=block;fontSize=10;exitX=0.75;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="s_pending" target="s_rejected">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="t4" value="admin: reject()" style="html=1;endArrow=block;fontSize=10;curved=1;" edge="1" parent="1" source="s_approved" target="s_rejected">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="880" y="105"/><mxPoint x="880" y="385"/></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="t5" value="admin: approve()" style="html=1;endArrow=block;fontSize=10;curved=1;" edge="1" parent="1" source="s_rejected" target="s_approved">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="940" y="385"/><mxPoint x="940" y="105"/></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note1" value="Note: approve()/reject() endpoints do not check the&#10;current status, so both re-approval and re-rejection&#10;are technically reachable from either terminal state." style="text;html=1;align=left;fontSize=10;fontStyle=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="470" width="560" height="50" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
