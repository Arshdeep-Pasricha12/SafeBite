        </mxCell>
        <mxCell id="c_db" value="&lt;&lt;component&gt;&gt;&#10;SQLite&#10;safebite.db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1070" y="90" width="160" height="90" as="geometry"/></mxCell>

        <!-- DEPLOYMENT PACKAGE -->
