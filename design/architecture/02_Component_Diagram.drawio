<mxfile host="app.diagrams.net">
  <diagram name="Component Diagram" id="comp-diagram">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- FRONTEND PACKAGE -->
        <mxCell id="pkg_fe" value="Frontend (React 18 + Vite SPA)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="420" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c_app" value="&lt;&lt;component&gt;&gt;&#10;App.jsx (Router)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="80" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="c_nav" value="&lt;&lt;component&gt;&gt;&#10;Navbar / ProtectedRoute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="c_pages" value="&lt;&lt;component&gt;&gt;&#10;Pages: Home, RestaurantListing,&#10;RestaurantDetail, LoginRegister,&#10;OwnerDashboard, AdminDashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="c_widgets" value="&lt;&lt;component&gt;&gt;&#10;CreateRestaurantModal,&#10;InspectionHistory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="c_authctx" value="&lt;&lt;component&gt;&gt;&#10;AuthContext&#10;(login/register/logout, JWT in localStorage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="240" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="c_api" value="&lt;&lt;component&gt;&gt;&#10;api.js (Axios service)&#10;restaurantApi / adminApi / userApi / inspectionApi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="360" height="60" as="geometry"/></mxCell>

        <!-- BACKEND PACKAGE -->
        <mxCell id="pkg_be" value="Backend (FastAPI + Python 3.12)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="40" width="430" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c_main" value="&lt;&lt;component&gt;&gt;&#10;main.py (FastAPI app + CORS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="570" y="80" width="370" height="40" as="geometry"/></mxCell>
        <mxCell id="c_routers" value="&lt;&lt;component&gt;&gt;&#10;API Routers:&#10;auth.py | restaurants.py | inspections.py | admin.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="570" y="140" width="370" height="60" as="geometry"/></mxCell>
        <mxCell id="c_core" value="&lt;&lt;component&gt;&gt;&#10;core: config.py, database.py, security.py&#10;(JWT create/decode, bcrypt hashing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="570" y="220" width="370" height="60" as="geometry"/></mxCell>
        <mxCell id="c_schemas" value="&lt;&lt;component&gt;&gt;&#10;schemas.py (Pydantic request/response models)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="570" y="300" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="c_models" value="&lt;&lt;component&gt;&gt;&#10;models.py (SQLAlchemy ORM entities)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="c_docker_be" value="&lt;&lt;component&gt;&gt;&#10;Dockerfile (backend container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="570" y="370" width="370" height="40" as="geometry"/></mxCell>

        <!-- DATABASE PACKAGE -->
        <mxCell id="pkg_db" value="Database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
