        <mxCell id="m8" value="8: bcrypt match result (True/False)" style="html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="390" as="sourcePoint"/><mxPoint x="900" y="390" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="alt1" value="alt  [invalid credentials]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="690" y="410" width="600" height="60" as="geometry"/></mxCell>
        <mxCell id="m9" value="9: 400 Bad Request 'Incorrect email or password'" style="html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="450" as="sourcePoint"/><mxPoint x="690" y="450" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="10: create_access_token({email, role})" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="500" as="sourcePoint"/><mxPoint x="1110" y="500" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="11: signed JWT token" style="html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="540" as="sourcePoint"/><mxPoint x="900" y="540" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="12: 200 OK {access_token, role, email, full_name}" style="html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="580" as="sourcePoint"/><mxPoint x="690" y="580" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="13: resolve response" style="html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="620" as="sourcePoint"/><mxPoint x="490" y="620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="14: setUser(userData); localStorage.setItem(token,user);&#10;axios.defaults.headers.Authorization = Bearer token" style="html=1;endArrow=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="650" width="220" height="30" as="geometry"/></mxCell>
        <mxCell id="m15" value="15: { success: true }" style="html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="700" as="sourcePoint"/><mxPoint x="290" y="700" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="16: redirect to role-based dashboard" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="740" as="sourcePoint"/><mxPoint x="90" y="740" as="targetPoint"/></mxGeometry></mxCell>

      </root>
