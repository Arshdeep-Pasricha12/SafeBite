{
  "manifest_version": 3,
  "name": "SafeBite — Food Safety Transparency",
  "version": "1.0.0",
  "description": "Real-time food safety transparency overlay and hygiene inspection audit ratings for online food ordering.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SafeBite Food Safety Transparency"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3001/*",
        "http://localhost:*/*",
        "https://www.swiggy.com/*",
        "https://www.zomato.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:8000/*"
  ]
}
